--- /dev/null
+++ b/crates/horizon-ios/src/lib.rs
@@ -0,0 +1,77 @@
+//! Horizon in an iOS app's process: the app loads this library and calls
+//! `horizon_ios_main` on its main thread, which never returns while the game runs.
+
+use std::ffi::{CStr, c_char, c_int};
+
+#[global_allocator]
+static ALLOCATOR: horizon_threads::Allocator = horizon_threads::ALLOCATOR;
+
+/// Starts the game with `argv[0..argc]` as its command line (no program name).
+/// Must be called on the main thread of a running UIKit app.
+///
+/// # Safety
+/// `argv` holds `argc` valid NUL-terminated strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn horizon_ios_main(argc: c_int, argv: *const *const c_char) -> c_int {
+    let args = (0..argc.max(0) as usize)
+        // SAFETY: the caller passes `argc` valid C strings.
+        .map(|i| unsafe { CStr::from_ptr(*argv.add(i)) }.to_string_lossy().into_owned())
+        .collect();
+    horizon_client::entry::set_args(args);
+    horizon_client::entry::main();
+    0
+}
+
+/// Input from the app's touch controls, keyboard and mouse (winit has none on iOS).
+#[cfg(target_os = "ios")]
+mod input {
+    use std::ffi::{CStr, c_char};
+    use winit::platform::ios::amadora;
+
+    /// A key by its USB HID usage (UIKeyboardHIDUsage).
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_key(hid: u32, pressed: bool) {
+        amadora::key(hid, pressed);
+    }
+    /// Text from the on-screen keyboard.
+    ///
+    /// # Safety
+    /// `text` is a valid NUL-terminated UTF-8 string.
+    #[unsafe(no_mangle)]
+    pub unsafe extern "C" fn horizon_ios_text(text: *const c_char) {
+        if !text.is_null() {
+            // SAFETY: the caller passes a valid C string.
+            amadora::text(&unsafe { CStr::from_ptr(text) }.to_string_lossy());
+        }
+    }
+    /// A mouse button: 0 left, 1 right, 2 middle.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_mouse_button(button: u32, pressed: bool) {
+        amadora::mouse_button(button, pressed);
+    }
+    /// The pointer at (`x`, `y`) in physical pixels.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_cursor(x: f64, y: f64) {
+        amadora::cursor(x, y);
+    }
+    /// Camera movement while the pointer is grabbed.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_mouse_motion(dx: f64, dy: f64) {
+        amadora::mouse_motion(dx, dy);
+    }
+    /// The wheel, in lines.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_scroll(dx: f64, dy: f64) {
+        amadora::scroll(dx, dy);
+    }
+    /// Whether the game holds the pointer (playing rather than in a menu).
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_cursor_grabbed() -> bool {
+        amadora::cursor_grabbed()
+    }
+    /// Whether the game has opened its window.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_has_window() -> bool {
+        amadora::has_window()
+    }
+}
