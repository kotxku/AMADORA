@@ -0,0 +1,182 @@
+//! Horizon in an iOS app's process: the app loads this library and calls
+//! `horizon_ios_main` on its main thread, which never returns while the game runs.
+
+use std::ffi::{CStr, c_char, c_int};
+
+#[global_allocator]
+static ALLOCATOR: horizon_threads::Allocator = horizon_threads::ALLOCATOR;
+
+/// Starts the game with `argv[0..argc]` as its command line (no program name).
+/// Must be called on the main thread of a running UIKit app.
+///
+/// # Safety
+/// `argv` holds `argc` valid NUL-terminated strings.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn horizon_ios_main(argc: c_int, argv: *const *const c_char) -> c_int {
+    let args = (0..argc.max(0) as usize)
+        // SAFETY: the caller passes `argc` valid C strings.
+        .map(|i| unsafe { CStr::from_ptr(*argv.add(i)) }.to_string_lossy().into_owned())
+        .collect();
+    horizon_client::entry::set_args(args);
+    horizon_client::entry::main();
+    0
+}
+
+/// Input from the app's touch controls, keyboard and mouse (winit has none on iOS).
+#[cfg(target_os = "ios")]
+mod input {
+    use std::ffi::{CStr, c_char};
+    use winit::platform::ios::amadora;
+
+    /// A key by its USB HID usage (UIKeyboardHIDUsage).
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_key(hid: u32, pressed: bool) {
+        amadora::key(hid, pressed);
+    }
+    /// Text from the on-screen keyboard.
+    ///
+    /// # Safety
+    /// `text` is a valid NUL-terminated UTF-8 string.
+    #[unsafe(no_mangle)]
+    pub unsafe extern "C" fn horizon_ios_text(text: *const c_char) {
+        if !text.is_null() {
+            // SAFETY: the caller passes a valid C string.
+            amadora::text(&unsafe { CStr::from_ptr(text) }.to_string_lossy());
+        }
+    }
+    /// A mouse button: 0 left, 1 right, 2 middle.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_mouse_button(button: u32, pressed: bool) {
+        amadora::mouse_button(button, pressed);
+    }
+    /// The pointer at (`x`, `y`) in physical pixels.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_cursor(x: f64, y: f64) {
+        amadora::cursor(x, y);
+    }
+    /// Camera movement while the pointer is grabbed.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_mouse_motion(dx: f64, dy: f64) {
+        amadora::mouse_motion(dx, dy);
+    }
+    /// The wheel, in lines.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_scroll(dx: f64, dy: f64) {
+        amadora::scroll(dx, dy);
+    }
+    /// Whether the game holds the pointer (playing rather than in a menu).
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_cursor_grabbed() -> bool {
+        amadora::cursor_grabbed()
+    }
+    /// Whether the game has opened its window.
+    #[unsafe(no_mangle)]
+    pub extern "C" fn horizon_ios_has_window() -> bool {
+        amadora::has_window()
+    }
+}
+
+/// Preparing 26.3's resources on the device, in the app's own JVM (iOS starts no processes).
+mod prepare {
+    use std::ffi::{CStr, CString, c_char, c_int};
+    use std::path::PathBuf;
+    use std::sync::OnceLock;
+
+    /// Runs one Java task (`horizon_prepare::java::InProcess`) in the app's JVM; 0 when it worked,
+    /// else the error, NUL-terminated, in `error[..len]`.
+    type Task = extern "C" fn(c_int, *const *const c_char, *mut c_char, usize) -> c_int;
+    /// A progress line, and the fraction done (negative when unchanged).
+    type Log = extern "C" fn(*const c_char, f32);
+
+    static TASK: OnceLock<Task> = OnceLock::new();
+
+    fn task(args: &[String]) -> Result<(), String> {
+        let task = TASK.get().ok_or("No Java to run the task in")?;
+        let owned: Vec<CString> = args
+            .iter()
+            .map(|a| CString::new(a.replace('\0', "")).unwrap_or_default())
+            .collect();
+        let pointers: Vec<*const c_char> = owned.iter().map(|c| c.as_ptr()).collect();
+        let mut error = vec![0u8; 4096];
+        match task(pointers.len() as c_int, pointers.as_ptr(), error.as_mut_ptr().cast(), error.len()) {
+            0 => Ok(()),
+            _ => Err(CStr::from_bytes_until_nul(&error)
+                .map(|e| e.to_string_lossy().into_owned())
+                .unwrap_or_else(|_| "The Java task failed".into())),
+        }
+    }
+
+    fn path(p: *const c_char) -> PathBuf {
+        // SAFETY: the caller passes valid C strings.
+        PathBuf::from(unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned())
+    }
+
+    /// `horizon-prepare --prepare --complete` from the app's own copy of the game: imports the
+    /// pinned files, runs the exporters through `task`, copies the sounds and checks the result in
+    /// `output`. Returns 0 when it is complete; the reason otherwise went to `log` last.
+    ///
+    /// # Safety
+    /// Every path is a valid NUL-terminated string; `task` and `log` stay callable meanwhile.
+    #[unsafe(no_mangle)]
+    #[allow(clippy::too_many_arguments)]
+    pub unsafe extern "C" fn horizon_ios_prepare(
+        root: *const c_char,
+        minecraft_dir: *const c_char,
+        version_json: *const c_char,
+        client_jar: *const c_char,
+        libraries_dir: *const c_char,
+        assets_dir: *const c_char,
+        server_jar: *const c_char,
+        output: *const c_char,
+        run_task: Task,
+        log: Log,
+    ) -> c_int {
+        let _ = TASK.set(run_task);
+        horizon_prepare::java::set_in_process(task);
+        let say = |line: &str| {
+            let line = CString::new(line.replace('\0', "")).unwrap_or_default();
+            log(line.as_ptr(), -1.0);
+        };
+        let progress = |fraction: f32| log(c"".as_ptr(), fraction * 0.9);
+        let options = horizon_prepare::Options {
+            root: path(root),
+            import: true,
+            minecraft_dir: Some(path(minecraft_dir)),
+            server_jar: Some(path(server_jar)),
+            java_home: None,
+            inputs: horizon_prepare::artifacts::Inputs {
+                version_json: Some(path(version_json)),
+                client_jar: Some(path(client_jar)),
+                libraries_dir: Some(path(libraries_dir)),
+                assets_dir: Some(path(assets_dir)),
+            },
+            output: Some(path(output)),
+        };
+        let result = horizon_prepare::prepare_with_progress(&options, &say, &progress)
+            .and_then(|resources| {
+                horizon_prepare::add_assets(
+                    "sounds",
+                    &options.root,
+                    Some(&resources),
+                    options.minecraft_dir.as_deref(),
+                    &options.inputs,
+                    &say,
+                )?;
+                let lacking = horizon_prepare::check(&options.root, &resources)?;
+                for line in &lacking {
+                    say(line);
+                }
+                if lacking.is_empty() { Ok(()) } else { Err("The prepared files are incomplete".into()) }
+            });
+        match result {
+            Ok(()) => {
+                log(c"".as_ptr(), 1.0);
+                0
+            }
+            Err(e) => {
+                say(&format!("error: {e}"));
+                1
+            }
+        }
+    }
+}
diff --git a/crates/horizon-prepare/src/java.rs b/crates/horizon-prepare/src/java.rs
index 1279cc6..a4cf69d 100644
--- a/crates/horizon-prepare/src/java.rs
+++ b/crates/horizon-prepare/src/java.rs
@@ -14,6 +14,35 @@ pub struct Jdk {
 
 const TIMEOUT: Duration = Duration::from_secs(3600);
 
+/// Runs a Java task in the caller's own JVM instead of a new process, for an app that can't start
+/// processes (AMADORA on iOS). Its argument lists: `["java", cwd, log, java's arguments...]`,
+/// `["worker", name, log, classpath, main, args...]` (one bootstrapped classpath per name, kept
+/// until `["close", name]`). Logs are `/dev/fd/<n>` paths of files the preparer opened.
+pub type InProcess = fn(&[String]) -> Result<(), String>;
+
+static IN_PROCESS: std::sync::OnceLock<InProcess> = std::sync::OnceLock::new();
+
+/// Sends every Java task to `run` from now on: one at a time, and with no compiler.
+pub fn set_in_process(run: InProcess) {
+    let _ = IN_PROCESS.set(run);
+}
+
+pub(crate) fn in_process() -> Option<InProcess> {
+    IN_PROCESS.get().copied()
+}
+
+/// An open log as a path a JVM in this process can open: the same file and position.
+#[cfg(unix)]
+pub(crate) fn fd_path(log: &fs::File) -> String {
+    use std::os::fd::AsRawFd;
+    format!("/dev/fd/{}", log.as_raw_fd())
+}
+
+#[cfg(not(unix))]
+pub(crate) fn fd_path(_: &fs::File) -> String {
+    String::new()
